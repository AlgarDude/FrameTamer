#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FRAMETAMER_VERSION_NUMBERS
PRODUCTVERSION FRAMETAMER_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FrameTamer for Windower"
            VALUE "FileVersion", FRAMETAMER_VERSION
            VALUE "ProductName", "FrameTamer"
            VALUE "ProductVersion", FRAMETAMER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
